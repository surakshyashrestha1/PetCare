<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pet_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">


        <!-- =============================================== -->
        <!-- TOP BAR -->
        <!-- =============================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="@color/pet_text"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Pet"
                    android:textColor="@color/pet_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Create a complete profile for your pet."
                    android:textColor="@color/pet_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- =============================================== -->
        <!-- PHOTO -->
        <!-- =============================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFF0E7"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    app:cardBackgroundColor="@color/pet_surface"
                    app:cardCornerRadius="66dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/pet_primary"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/ivPetPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Pet photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/petcare_hero" />

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChoosePhoto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Choose Photo"
                    android:textAllCaps="false"
                    android:textColor="@color/pet_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pet_surface"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/pet_primary"
                    app:strokeWidth="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Add a clear photo of your pet"
                    android:textColor="@color/pet_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- =============================================== -->
        <!-- BASIC INFORMATION -->
        <!-- =============================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Basic Information"
            android:textColor="@color/pet_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tell us the basic details about your pet."
            android:textColor="@color/pet_text_secondary"
            android:textSize="12sp" />


        <!-- PET NAME -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Pet Name *"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/pet_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- SPECIES -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSpecies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Species *"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/pet_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpecies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dog, Cat or Other"
                android:inputType="textCapWords"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- BREED -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutBreed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Breed *"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/pet_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Golden Retriever"
                android:inputType="textCapWords"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- AGE + WEIGHT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Age (years) *"
                app:boxBackgroundColor="@color/pet_surface"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/pet_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/pet_text"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Weight (kg) *"
                app:boxBackgroundColor="@color/pet_surface"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/pet_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/pet_text"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- =============================================== -->
        <!-- CARE INFORMATION -->
        <!-- =============================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Care Information"
            android:textColor="@color/pet_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Store useful information for daily care and health."
            android:textColor="@color/pet_text_secondary"
            android:textSize="12sp" />


        <!-- DIET -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Dietary Preference"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E9B9A1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Grain-free kibble"
                android:inputType="textCapSentences"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ALLERGIES -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Allergies"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E9B9A1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAllergies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. None recorded"
                android:inputType="textCapSentences"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- VACCINATION -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Vaccination History"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E9B9A1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVaccination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Annual vaccination due"
                android:inputType="textCapSentences"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- FAVOURITE TOY -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Favourite Toy"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E9B9A1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFavouriteToy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Rope tug toy"
                android:inputType="textCapSentences"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- NOTES -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notes"
            app:boxBackgroundColor="@color/pet_surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#E9B9A1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="14dp"
                android:textColor="@color/pet_text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- SAVE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePet"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="Save Pet Profile"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pet_primary"
            app:cornerRadius="19dp" />


        <!-- PROGRESS -->

        <ProgressBar
            android:id="@+id/petProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>