<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- SMALL PAW LOGO -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardBackgroundColor="@color/pet_surface"
            app:cardCornerRadius="36dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/pet_primary"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pets_24"
                android:contentDescription="PetCare logo"
                app:tint="@color/pet_primary" />

        </com.google.android.material.card.MaterialCardView>


        <!-- APP NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="PetCare"
            android:textColor="@color/pet_text"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />


        <!-- TAGLINE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Your pet's happiness,\nour priority."
            android:textColor="@color/pet_text_secondary"
            android:textSize="17sp"
            android:lineSpacingExtra="2dp" />


        <!-- PET HERO IMAGE -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="285dp"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/pet_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/petcare_hero"
                android:scaleType="centerCrop"
                android:contentDescription="Dog and cat illustration" />

        </com.google.android.material.card.MaterialCardView>


        <!-- APP FEATURES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="🐾 Pet Profiles   •   ✓ Daily Care   •   ✉ SMS Delegation"
            android:textColor="@color/pet_text_secondary"
            android:textSize="12sp" />


        <!-- GET STARTED / REGISTER -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="Get Started  →"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pet_primary"
            app:cornerRadius="22dp" />


        <!-- LOGIN -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Log In"
            android:textAllCaps="false"
            android:textColor="@color/pet_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pet_surface"
            app:cornerRadius="22dp"
            app:strokeColor="@color/pet_primary"
            app:strokeWidth="1dp" />


        <!-- BOTTOM TEXT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Simple care. Happier pets."
            android:textColor="@color/pet_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>